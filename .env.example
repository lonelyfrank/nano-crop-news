# Variabili della Edge Function `fetch-rss` (supabase/functions/fetch-rss).
# Impostale sul progetto con:
#   supabase secrets set --env-file .env
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono già iniettate automaticamente
# da Supabase in ogni function: non vanno messe qui.)

RSS_USER_AGENT="NanoCropNewsBot/1.0 (+https://tuodominio.it)"
RSS_FETCH_TIMEOUT_MS=15000
RSS_CLUSTER_SIMILARITY_THRESHOLD=80
RSS_CLUSTER_WINDOW_HOURS=72

# Promemoria: la frequenza dello scheduler (default 20 min, spec 15-30 min)
# è impostata nell'espressione cron della migration
# supabase/migrations/20250101000013_schedule_rss_fetch.sql, non qui.
