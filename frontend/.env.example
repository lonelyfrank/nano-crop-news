# Frontend Next.js — pubbliche (finiscono nel bundle browser, non sono segrete)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-public-key

# Script di ingestion (scripts/ingest) — MAI pubbliche, solo locale/CI
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=la-tua-service-role-key
RSS_USER_AGENT="NanoCropNewsBot/1.0 (+https://tuodominio.it)"
RSS_FETCH_TIMEOUT_MS=15000
RSS_CLUSTER_SIMILARITY_THRESHOLD=80
RSS_CLUSTER_WINDOW_HOURS=72

# Cache Redis (Upstash) per l'ingestion — opzionale: se assenti, l'ingestion
# funziona comunque, semplicemente senza cache dei feed grezzi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
